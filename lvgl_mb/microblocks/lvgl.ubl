module LVGL Output
author Ste7an
version 1 1 
choices style_types min max rotation range angles 
choices obj_types button arc slider led switch bar tabview list 
description 'LVGL support for MicroBlocks'

  spec ' ' '[tft:LVGLon]' 'enable_lvgl _' 'bool' true
  spec ' ' '[tft:LVGLaddbtn]' 'btn _ : scale _ : text _ : parent _' 'str num str str' 'btn' 1 'btn' 'lv_scr_act'
  spec ' ' '[tft:LVGLaddlabel]' 'label _ : scale _ : text _ : parent _' 'str num str str' 'label' 1 'label' 'lv_scr_act'
  spec ' ' '[tft:LVGLaddobj]' 'add _ as _ : parent _' 'str.obj_types str str' 'button' '' 'lv_scr_act'
  spec ' ' '[tft:LVGLaddimg]' 'img path _  as  _ : parent _' 'str str str' '' 'img' 'lv_scr_act'
  spec ' ' '[tft:LVGLaddstyle]' 'set _ of _ to _ : until _' 'str.style_types str auto auto' 'min' '' '' ''
  spec ' ' '[tft:LVGLaddtab]' 'tab _ parent _' 'str str' 'tab' ''
  spec ' ' '[tft:LVGLsetpos]' 'set_pos _ x _ y _' 'str num num' '' 100 100
  spec ' ' '[tft:LVGLsetsize]' 'set_size _ width _ height _' 'str num num' '' 100 10
  spec ' ' '[tft:LVGLsetval]' 'set_val _ value _' 'str num' '' 10
  spec 'r' '[tft:LVGLgetval]' 'get_val _' 'str' ''
  spec ' ' '[tft:LVGLsettext]' 'set_text _ text _ : scale _' 'str str num' '' 'text' 1
  spec ' ' '[tft:LVGLsetcolor]' 'set_color _ color _ : extra _ : extra _' 'str color color color' ''
  spec 'r' 'makeColor' 'color r _ g _ b _ (0-255)' 'num num num' 0 100 100
  space
  spec 'r' 'event_available' 'event available'
  spec 'r' '[tft:LVGLgetevent]' 'get_event'
  space
  spec 'r' 'screen' 'screen'
  spec ' ' '[tft:LVGLsetparent]' 'set _ parent _' 'str str' '' ''
  spec 'r' '[tft:LVGLgetallobjs]' 'get_all_objects'
  spec ' ' '[tft:LVGLdelobj]' 'del_obj _' 'str' ''
  spec ' ' 'delete_all_objects' 'delete_all_objects'
  

to delete_all_objects {
  local 'all_objects' ('[tft:LVGLgetallobjs]')
  for i (size all_objects) {
    '[tft:LVGLdelobj]' (at i all_objects)
  }
}

to event_available {
  return false
}

to makeColor r g b {
  r = (maximum 0 (minimum r 255))
  g = (maximum 0 (minimum g 255))
  b = (maximum 0 (minimum b 255))
  return ((r << 16) | ((g << 8) | b))
}

to screen {
  return 'lv_scr_act'
}

